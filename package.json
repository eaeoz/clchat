{
  "name": "clchat",
  "version": "1.0.7",
  "type": "module",
  "description": "CLI chat client for Social App - Connect, chat, and communicate from your terminal",
  "main": "src/index.js",
  "bin": {
    "clchat": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:exe": "node build.js"
  },
  "keywords": [
    "cli",
    "chat",
    "terminal",
    "realtime",
    "socketio"
  ],
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "dotenv": "^16.4.7",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
